#
# Copy to /var/lib/badgeserver/badges.env and edit.
#   sudo install -o root -g badges -m 0640 deploy/badges.env.example /var/lib/badgeserver/badges.env
#   sudoedit /var/lib/badgeserver/badges.env
#
# Only KEY=VALUE lines are read. Values are taken verbatim; a surrounding pair
# of double quotes is optional (spaces and "<>" are fine without them).

# --- required ---------------------------------------------------------------

# Long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# The exact public origin badge holders and validators will reach, no trailing
# slash. Every URL inside the issued badges is built from this.
#   direct HTTP on the LAN :  http://badges.dsg.lan:4000
#   behind a TLS proxy     :  https://badges.example.org
EXTERNAL_URL=http://badges.dsg.lan:4000

# --- network -------------------------------------------------------------

# Address gunicorn listens on.
#   0.0.0.0:4000    reachable from other hosts (direct access, no proxy)
#   127.0.0.1:4000  localhost only (put a reverse proxy in front)
BIND=0.0.0.0:4000

# Trusted reverse-proxy hops. Leave 0 for direct access; set to 1 when a
# single nginx/apache sits in front (then also use an https:// EXTERNAL_URL).
PROXY_FIX_HOPS=0

# Secure-only session cookie. Defaults to true for an https:// EXTERNAL_URL
# and false for http://. Only set this if you need to override that.
# SESSION_COOKIE_SECURE=false

# --- appearance --------------------------------------------------------

SITE_TITLE=LibrePlan Badges

# Header logo: a filename in static/ (e.g. "my-logo.png") or an absolute
# http(s) URL. Defaults to the bundled project logo.
# SITE_LOGO=project-logo.png

# --- single sign-on (optional) -----------------------------------------
#
# When OIDC_ISSUER and OIDC_CLIENT_ID are both set, the admin login page
# offers "Sign in with single sign-on" alongside the local admin login.
# When unset, the local username/password login is the only way in.
#
# OIDC_ISSUER=https://idp.example.org/realms/myorg
# OIDC_CLIENT_ID=badges-admin
# OIDC_CLIENT_SECRET=                 # only for confidential clients
# OIDC_SCOPES=openid profile email
#
# Server-side origin for discovery/token/JWKS when the server (e.g. inside a
# container) reaches the IdP at a different host than the browser.
# OIDC_BACKCHANNEL_ORIGIN=http://keycloak:8080
#
# When badge administration is delegated to a parent application, set this
# to the URL that authorises the user. {organization_id} is replaced with
# the organization_id query parameter from /admin/oidc?organization_id=...
# The access token is sent as a Bearer header; 200/204 = allowed.
# OIDC_AUTHORIZATION_URL=https://api.example.org/organizations/{organization_id}/badges

# --- languages (optional) ---------------------------------------------
#
# Offered languages, comma-separated. English is the source language; the
# shipped translations are Spanish, German, French and Dutch. Visitors switch
# with the header links (and ?lang=xx, remembered in their session); with no
# choice the browser's Accept-Language header decides, then the default below.
# Drop codes to hide languages; the switcher hides itself when only one is set.
# LANGUAGES=en,es,de,fr,nl
# BABEL_DEFAULT_LOCALE=en

# --- e-mail (award notifications) ----------------------------------------

MAIL_ENABLED=true
SMTP_HOST=smtp.libreplan.dev
# 25 with SMTP_SECURITY=none for an internal relay; 587 starttls; 465 ssl
SMTP_PORT=587
# one of: none | starttls | ssl
SMTP_SECURITY=starttls
# Leave SMTP_USERNAME and SMTP_PASSWORD BLANK if the relay accepts mail from
# this host without authentication (common for an internal MTA).
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=LibrePlan Badges <badges@libreplan.dev>
# Optional:
MAIL_REPLY_TO=

# --- self-service badges (optional) -----------------------------------

# SELF_SERVICE_ENABLED=true      # set false to disable public badge claiming
# CLAIM_EXPIRY_HOURS=24          # confirmation-link lifetime

# --- limits (optional) --------------------------------------------------

# RATELIMIT_LOGIN=5 per minute; 30 per hour
# RATELIMIT_VERIFY=12 per minute; 80 per hour
# RATELIMIT_CLAIM=4 per minute; 15 per hour; 40 per day
# CSV_AWARD_MAX_ROWS=200
# MAX_UPLOAD_BYTES=3145728
# BADGE_IMAGE_SIZE=512

# Rate limits are counted per gunicorn worker unless a shared store is set.
# With more than one worker, point this at redis for exact enforcement.
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
